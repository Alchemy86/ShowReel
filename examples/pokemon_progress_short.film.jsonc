// =====================================================================
//  AI COMPLETES POKÉMON — progress reel (YouTube Short)
// =====================================================================
//
//  A staged progress video: what the pixels-only Pokémon-playing agent
//  has actually done, in order, ending on the goal it hasn't reached yet.
//  Every number on screen is a real, dated measurement — see
//  `pokemon_progress_short.assets.md` for exactly where each one came
//  from and the commands to reproduce it. Nothing here claims the game
//  is beaten; the frontier today is crossing Viridian Forest, and the
//  end card says so.
//
//  RENDER IT (assets are NOT committed — see the .assets.md beside this
//  file for exact source paths and the one-time asset-prep step):
//    showreel render examples/pokemon_progress_short.film.jsonc \
//      -A <pixelgb-images-root> -A <derived-assets-dir> -A <swarm-clip-dir> \
//      --crf 20 -o docs/pokemon-progress-short.mp4
//
//  Vertical 1080×1920 for YouTube Shorts. Nine chapters:
//    1  hook ................ the ambition, stated honestly up front
//    2  nothing .............. it starts with zero
//    3  bedroom → house ...... first two milestones
//    4  Oak / starter / rival  the lab
//    5  Route 1 / mart / dex   the errand
//    6  reads the shop screen  a hardcoded script, replaced — 0/20 → 20/20
//    7  Viridian Forest ...... the current frontier
//    8  TODAY ................ a real swarm grid + today's finish-rate jump
//    9  the goal .............. stated as a goal, not a claim
//
//  Grade is "documentary" (muted) over the journey chapters (3–7) and
//  natural colour on the bookends + the TODAY payoff (1, 8, 9) — grounded
//  journey, vivid arrival. Music is the built-in generated chiptune
//  (`src/music.rs`), mood "title", arranged to open on a held tone (not
//  a drum — see AGENTS.md) and build to full intensity under TODAY.
// =====================================================================
{
  "width": 1080,
  "height": 1920,
  "fps": 30.0,
  "title": "AI completes Pokémon — progress reel",
  "background": "#05070d",

  "audio": [
    {
      "music": {
        "mood": "title",
        "bpm": 120,
        "fit": "film",
        "arrangement": [
          { "name": "hook",    "bars": 2, "intensity": "tone" },
          { "name": "rise",    "bars": 4, "intensity": "kick" },
          { "name": "motion",  "bars": 2, "intensity": "pulse" },
          { "name": "tension", "bars": 2, "intensity": "build" },
          { "name": "hush",    "bars": 1, "intensity": "tone" },
          { "name": "today",   "bars": 4, "intensity": "full" },
          { "name": "goal",    "bars": 3, "intensity": "full" }
        ]
      },
      "fade_in": 0.2,
      "fade_out": 1.6,
      "gain": 0.9
    }
  ],

  // ===============================================================
  //  1 — HOOK. States the ambition AND the honesty in one breath —
  //  the subtitle is doing real work, not decoration.
  // ===============================================================
  "opening": {
    "name": "hook",
    "duration": 2.3,
    "background": "#05070d",
    "layers": [
      {
        "type": "gradient",
        "stops": [ [0.0, "#101a33"], [1.0, "#05070d"] ],
        "angle": 90.0
      },
      {
        "type": "still",
        "asset": "title/four-shade/8x/pokemon-logo.png",
        "fit": "contain",
        "placement": { "fx": 0.18, "fy": 0.09, "fw": 0.64, "fh": 0.14 },
        "enter": { "kind": "fade", "duration": 0.5, "timing": { "kind": "eased", "easing": "out-cubic" } }
      },
      {
        "type": "title",
        "text": "AI COMPLETES POKÉMON",
        "subtitle": "the journey so far — not there yet",
        "placement": { "fx": 0.06, "fy": 0.40, "fw": 0.88, "fh": 0.30 },
        "enter": {
          "kind": "chars", "stagger": 0.035, "rise": 26.0, "duration": 0.5,
          "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } }
        }
      }
    ]
  },

  "then": [

    // =============================================================
    //  2 — NOTHING. Abrupt cut in — the blunt truth deserves no
    //  dissolve.
    // =============================================================
    {
      "transition": { "duration": 0.05, "presentation": { "kind": "cut" }, "timing": { "kind": "eased", "easing": "linear" } },
      "scene": {
        "name": "nothing",
        "duration": 2.0,
        "background": "#020204",
        "layers": [
          {
            "type": "title",
            "text": "IT STARTS KNOWING NOTHING.",
            "subtitle": "just the screen it sees — no memory of the game",
            "placement": { "fx": 0.08, "fy": 0.20, "fw": 0.84, "fh": 0.60 },
            "enter": { "kind": "fade", "duration": 0.4, "timing": { "kind": "eased", "easing": "out-cubic" } }
          }
        ]
      }
    },

    // =============================================================
    //  3 — BEDROOM → HOUSE. Two real captured frames from a finished
    //  run (agent a01, seed 4200127), timed back to back.
    // =============================================================
    {
      "transition": { "duration": 0.4, "presentation": { "kind": "fade", "through": "#000000" }, "timing": { "kind": "eased", "easing": "in-out-cubic" } },
      "scene": {
        "name": "bedroom-house",
        "duration": 4.0,
        "background": "#0a0e18",
        "grade": "documentary",
        "layers": [
          {
            "type": "still",
            "asset": "maps/four-shade/8x/038-reds-house-2f.png",
            "fit": "cover",
            "camera": {
              "shots": [
                { "at": 0.0, "framing": { "on": "whole" }, "ease": "in-out-cubic" },
                { "at": 4.0, "framing": { "on": "at", "fx": 0.5, "fy": 0.55, "height": 700.0 }, "ease": "in-out-cubic" }
              ]
            }
          },
          { "type": "scrim", "height": 0.5, "strength": 0.85, "colour": "#000000" },

          { "type": "solid", "colour": "#05070dd0", "placement": { "fx": 0.06, "fy": 0.18, "fw": 0.88, "fh": 0.34 }, "from": 0.0, "duration": 2.0, "z": 2 },
          { "type": "still", "asset": "frames/bedroom.png", "fit": "contain", "placement": { "fx": 0.09, "fy": 0.20, "fw": 0.82, "fh": 0.30 }, "from": 0.0, "duration": 2.0, "z": 3,
            "enter": { "kind": "fade", "duration": 0.3 }, "exit": { "kind": "fade", "duration": 0.3 } },
          { "type": "title", "text": "LEAVES THE BEDROOM.", "placement": { "fx": 0.06, "fy": 0.58, "fw": 0.88, "fh": 0.30 }, "from": 0.1, "duration": 1.8, "z": 4,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 800, "italic": false, "size": 72.0, "tracking": -0.015, "line_height": 1.08, "fill": "#ffffff", "case": "as-written", "align": "centre", "tabular": false },
            "enter": { "kind": "chars", "stagger": 0.03, "rise": 20.0, "duration": 0.4, "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } } } },

          { "type": "solid", "colour": "#05070dd0", "placement": { "fx": 0.06, "fy": 0.18, "fw": 0.88, "fh": 0.34 }, "from": 2.0, "duration": 2.0, "z": 2 },
          { "type": "still", "asset": "frames/leave-house.png", "fit": "contain", "placement": { "fx": 0.09, "fy": 0.20, "fw": 0.82, "fh": 0.30 }, "from": 2.0, "duration": 2.0, "z": 3,
            "enter": { "kind": "fade", "duration": 0.3 }, "exit": { "kind": "fade", "duration": 0.3 } },
          { "type": "title", "text": "THEN THE HOUSE.", "placement": { "fx": 0.06, "fy": 0.58, "fw": 0.88, "fh": 0.30 }, "from": 2.1, "duration": 1.8, "z": 4,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 800, "italic": false, "size": 72.0, "tracking": -0.015, "line_height": 1.08, "fill": "#ffffff", "case": "as-written", "align": "centre", "tabular": false },
            "enter": { "kind": "chars", "stagger": 0.03, "rise": 20.0, "duration": 0.4, "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } } } }
        ]
      }
    },

    // =============================================================
    //  4 — OAK / STARTER / RIVAL. Portraits from the cartridge; the
    //  starter is shown as a choice (all three), not a specific pick —
    //  the run's own choice was never confirmed independently.
    // =============================================================
    {
      "transition": { "duration": 0.3, "presentation": { "kind": "dissolve" }, "timing": { "kind": "eased", "easing": "in-out-cubic" } },
      "scene": {
        "name": "oak-starter-rival",
        "duration": 4.5,
        "background": "#0a0e18",
        "grade": "documentary",
        "layers": [
          { "type": "still", "asset": "maps/four-shade/8x/000-pallet-town.png", "fit": "cover" },
          { "type": "scrim", "height": 0.5, "strength": 0.85, "colour": "#000000" },

          { "type": "still", "asset": "frames/oak-portrait.png", "fit": "contain", "placement": { "fx": 0.28, "fy": 0.18, "fw": 0.44, "fh": 0.28 }, "from": 0.0, "duration": 1.5, "z": 3,
            "enter": { "kind": "scale", "from": 0.85, "duration": 0.35 }, "exit": { "kind": "fade", "duration": 0.25 } },
          { "type": "title", "text": "OAK.", "placement": { "fx": 0.06, "fy": 0.58, "fw": 0.88, "fh": 0.30 }, "from": 0.05, "duration": 1.4, "z": 4,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 800, "italic": false, "size": 72.0, "tracking": -0.015, "line_height": 1.08, "fill": "#ffffff", "case": "as-written", "align": "centre", "tabular": false },
            "enter": { "kind": "chars", "stagger": 0.03, "rise": 20.0, "duration": 0.4, "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } } } },

          { "type": "still", "asset": "sprites/four-shade/8x/pokemon-front-001-bulbasaur.png", "fit": "contain", "placement": { "fx": 0.06, "fy": 0.20, "fw": 0.28, "fh": 0.18 }, "from": 1.5, "duration": 1.6, "z": 3,
            "enter": { "kind": "rise", "distance": 24.0, "duration": 0.3 } },
          { "type": "still", "asset": "sprites/four-shade/8x/pokemon-front-004-charmander.png", "fit": "contain", "placement": { "fx": 0.36, "fy": 0.20, "fw": 0.28, "fh": 0.18 }, "from": 1.6, "duration": 1.5, "z": 3,
            "enter": { "kind": "rise", "distance": 24.0, "duration": 0.3 } },
          { "type": "still", "asset": "sprites/four-shade/8x/pokemon-front-007-squirtle.png", "fit": "contain", "placement": { "fx": 0.66, "fy": 0.20, "fw": 0.28, "fh": 0.18 }, "from": 1.7, "duration": 1.4, "z": 3,
            "enter": { "kind": "rise", "distance": 24.0, "duration": 0.3 } },
          { "type": "title", "text": "THE STARTER.", "placement": { "fx": 0.06, "fy": 0.58, "fw": 0.88, "fh": 0.30 }, "from": 1.6, "duration": 1.4, "z": 4,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 800, "italic": false, "size": 72.0, "tracking": -0.015, "line_height": 1.08, "fill": "#ffffff", "case": "as-written", "align": "centre", "tabular": false },
            "enter": { "kind": "chars", "stagger": 0.03, "rise": 20.0, "duration": 0.4, "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } } } },

          { "type": "still", "asset": "frames/rival-portrait.png", "fit": "contain", "placement": { "fx": 0.28, "fy": 0.18, "fw": 0.44, "fh": 0.28 }, "from": 3.1, "duration": 1.4, "z": 3,
            "enter": { "kind": "scale", "from": 0.85, "duration": 0.35 } },
          { "type": "title", "text": "THE FIRST RIVAL BATTLE.", "placement": { "fx": 0.06, "fy": 0.58, "fw": 0.88, "fh": 0.30 }, "from": 3.15, "duration": 1.35, "z": 4,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 800, "italic": false, "size": 66.0, "tracking": -0.015, "line_height": 1.08, "fill": "#ffffff", "case": "as-written", "align": "centre", "tabular": false },
            "enter": { "kind": "chars", "stagger": 0.03, "rise": 20.0, "duration": 0.4, "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } } } }
        ]
      }
    },

    // =============================================================
    //  5 — ROUTE 1 / MART / PARCEL / POKÉDEX.
    // =============================================================
    {
      "transition": { "duration": 0.3, "presentation": { "kind": "dissolve" }, "timing": { "kind": "eased", "easing": "in-out-cubic" } },
      "scene": {
        "name": "route1-mart-dex",
        "duration": 4.0,
        "background": "#0a0e18",
        "grade": "documentary",
        "layers": [
          { "type": "still", "asset": "maps/four-shade/8x/012-route-1.png", "fit": "cover" },
          { "type": "scrim", "height": 0.5, "strength": 0.85, "colour": "#000000" },

          { "type": "solid", "colour": "#05070dd0", "placement": { "fx": 0.06, "fy": 0.18, "fw": 0.88, "fh": 0.30 }, "from": 0.0, "duration": 1.3, "z": 2 },
          { "type": "still", "asset": "frames/route-1.png", "fit": "contain", "placement": { "fx": 0.09, "fy": 0.20, "fw": 0.82, "fh": 0.26 }, "from": 0.0, "duration": 1.3, "z": 3,
            "enter": { "kind": "fade", "duration": 0.25 } },
          { "type": "title", "text": "ROUTE 1.", "placement": { "fx": 0.06, "fy": 0.58, "fw": 0.88, "fh": 0.30 }, "from": 0.05, "duration": 1.2, "z": 4,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 800, "italic": false, "size": 72.0, "tracking": -0.015, "line_height": 1.08, "fill": "#ffffff", "case": "as-written", "align": "centre", "tabular": false },
            "enter": { "kind": "chars", "stagger": 0.03, "rise": 20.0, "duration": 0.4, "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } } } },

          { "type": "solid", "colour": "#05070dd0", "placement": { "fx": 0.06, "fy": 0.18, "fw": 0.88, "fh": 0.30 }, "from": 1.3, "duration": 1.3, "z": 2 },
          { "type": "still", "asset": "frames/collect-parcel.png", "fit": "contain", "placement": { "fx": 0.09, "fy": 0.20, "fw": 0.82, "fh": 0.26 }, "from": 1.3, "duration": 1.3, "z": 3,
            "enter": { "kind": "fade", "duration": 0.25 } },
          { "type": "title", "text": "THE MART. THE PARCEL.", "placement": { "fx": 0.06, "fy": 0.58, "fw": 0.88, "fh": 0.30 }, "from": 1.35, "duration": 1.2, "z": 4,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 800, "italic": false, "size": 62.0, "tracking": -0.015, "line_height": 1.08, "fill": "#ffffff", "case": "as-written", "align": "centre", "tabular": false },
            "enter": { "kind": "chars", "stagger": 0.03, "rise": 20.0, "duration": 0.4, "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } } } },

          { "type": "still", "asset": "sprites/four-shade/16x/overworld-pokedex.png", "fit": "contain", "placement": { "fx": 0.34, "fy": 0.22, "fw": 0.32, "fh": 0.20 }, "from": 2.6, "duration": 1.4, "z": 3,
            "enter": { "kind": "scale", "from": 0.5, "duration": 0.4, "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 140.0, "damping": 14.0, "clamp": false } } } },
          { "type": "title", "text": "THE POKÉDEX.", "placement": { "fx": 0.06, "fy": 0.58, "fw": 0.88, "fh": 0.30 }, "from": 2.65, "duration": 1.35, "z": 4,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 800, "italic": false, "size": 72.0, "tracking": -0.015, "line_height": 1.08, "fill": "#ffffff", "case": "as-written", "align": "centre", "tabular": false },
            "enter": { "kind": "chars", "stagger": 0.03, "rise": 20.0, "duration": 0.4, "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } } } }
        ]
      }
    },

    // =============================================================
    //  6 — READS THE SHOP SCREEN. The real numbers: a hardcoded
    //  BUY/SELL script replaced by a screen-read money check.
    //  0/20 → 20/20 at two wallet levels (¥775, ¥475), measured today
    //  — see the .assets.md for the exact files. The wallet could not
    //  afford the network's over-ambitious order, not "afford nothing":
    //  the caption says that precisely, not the looser brief framing.
    // =============================================================
    {
      "transition": { "duration": 0.35, "presentation": { "kind": "push", "direction": "left" }, "timing": { "kind": "eased", "easing": "in-out-cubic" } },
      "scene": {
        "name": "shop-screen",
        "duration": 4.0,
        "background": "#0a0e18",
        "grade": "documentary",
        "layers": [
          { "type": "still", "asset": "maps/four-shade/8x/042-viridian-mart.png", "fit": "cover" },
          { "type": "scrim", "height": 0.55, "strength": 0.85, "colour": "#000000" },

          { "type": "title", "text": "READS THE SHOP SCREEN.", "placement": { "fx": 0.06, "fy": 0.08, "fw": 0.88, "fh": 0.26 }, "from": 0.0, "duration": 4.0, "z": 4,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 800, "italic": false, "size": 64.0, "tracking": -0.015, "line_height": 1.08, "fill": "#ffffff", "case": "as-written", "align": "centre", "tabular": false },
            "enter": { "kind": "chars", "stagger": 0.025, "rise": 20.0, "duration": 0.4, "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } } } },

          { "type": "still", "asset": "frames/buy-pokeballs.png", "fit": "contain", "placement": { "fx": 0.30, "fy": 0.34, "fw": 0.40, "fh": 0.26 }, "z": 2,
            "enter": { "kind": "fade", "duration": 0.4 } },

          { "type": "counter", "count": { "from": 0.0, "to": 0.0, "over": 0.01, "decimals": 0, "suffix": " / 20" }, "label": "NETWORK ALONE",
            "placement": { "fx": 0.08, "fy": 0.64, "fw": 0.38, "fh": 0.14 }, "from": 0.2, "duration": 1.7, "z": 3,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 700, "italic": false, "size": 72.0, "tracking": -0.01, "line_height": 1.0, "fill": "#ff6a6a", "case": "as-written", "align": "centre", "tabular": true },
            "label_style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 600, "italic": false, "size": 20.0, "tracking": 0.1, "line_height": 1.2, "fill": "#c4cbd6", "case": "upper", "align": "centre", "tabular": false },
            "enter": { "kind": "rise", "distance": 30.0, "duration": 0.35 }, "exit": { "kind": "fade", "duration": 0.25 } },

          { "type": "counter", "count": { "from": 0.0, "to": 20.0, "over": 1.1, "easing": "out-expo", "decimals": 0, "suffix": " / 20" }, "label": "READS THE SCREEN",
            "placement": { "fx": 0.54, "fy": 0.64, "fw": 0.38, "fh": 0.14 }, "from": 2.0, "duration": 2.0, "z": 3,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 700, "italic": false, "size": 72.0, "tracking": -0.01, "line_height": 1.0, "fill": "#ffd147", "case": "as-written", "align": "centre", "tabular": true },
            "label_style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 600, "italic": false, "size": 20.0, "tracking": 0.1, "line_height": 1.2, "fill": "#c4cbd6", "case": "upper", "align": "centre", "tabular": false },
            "enter": { "kind": "rise", "distance": 30.0, "duration": 0.35 } },

          { "type": "lower-third", "text": "a wallet too poor for the full order", "detail": "every run still bought what it could afford", "accent": "#ffd147",
            "placement": { "fx": 0.06, "fy": 0.86, "fw": 0.88, "fh": 0.10 }, "from": 2.2, "duration": 1.8, "z": 4,
            "enter": { "kind": "fade", "duration": 0.4 } }
        ]
      }
    },

    // =============================================================
    //  7 — VIRIDIAN FOREST. The current, certified frontier.
    // =============================================================
    {
      "transition": { "duration": 0.3, "presentation": { "kind": "dissolve" }, "timing": { "kind": "eased", "easing": "in-out-cubic" } },
      "scene": {
        "name": "forest",
        "duration": 2.2,
        "background": "#0a0e18",
        "grade": "documentary",
        "layers": [
          { "type": "still", "asset": "maps/four-shade/8x/051-viridian-forest.png", "fit": "cover" },
          { "type": "scrim", "height": 0.5, "strength": 0.85, "colour": "#000000" },
          { "type": "still", "asset": "frames/forest-gate.png", "fit": "contain", "placement": { "fx": 0.20, "fy": 0.18, "fw": 0.60, "fh": 0.30 }, "z": 2,
            "enter": { "kind": "fade", "duration": 0.3 } },
          { "type": "title", "text": "VIRIDIAN FOREST.", "placement": { "fx": 0.06, "fy": 0.58, "fw": 0.88, "fh": 0.30 }, "z": 4,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 800, "italic": false, "size": 72.0, "tracking": -0.015, "line_height": 1.08, "fill": "#ffffff", "case": "as-written", "align": "centre", "tabular": false },
            "enter": { "kind": "chars", "stagger": 0.03, "rise": 20.0, "duration": 0.4, "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } } } }
        ]
      }
    },

    // =============================================================
    //  8 — TODAY. A real 16-agent swarm grid (mGBA, today's run),
    //  with today's real before/after finish-rate stat overlaid —
    //  3/16 -> 11/16, 8 gained, 0 lost. The counter is a stat graphic,
    //  not a claim that this exact clip shows 11 finishing on screen.
    // =============================================================
    {
      "transition": { "duration": 0.5, "presentation": { "kind": "fade", "through": "#000000" }, "timing": { "kind": "eased", "easing": "in-out-cubic" } },
