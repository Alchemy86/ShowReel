// =====================================================================
//  AI COMPLETES POKÉMON — progress reel (YouTube Short) — v2
// =====================================================================
//
//  A staged progress video: what the pixels-only Pokémon-playing agent
//  has actually done, in order — now opening on the payoff instead of
//  building to it. Every number on screen is a real, dated measurement —
//  see `pokemon_progress_short.assets.md` for exactly where each one
//  came from and the commands to reproduce it. Nothing here claims the
//  game is beaten; the frontier today is crossing Viridian Forest, and
//  the closing card still says so.
//
//  RENDER IT (assets are NOT committed — see the .assets.md beside this
//  file for exact source paths and the one-time asset-prep steps):
//    showreel render examples/pokemon_progress_short.film.jsonc \
//      -A <pixelgb-images-root> -A <derived-assets-dir> -A <swarm-clip-dir> \
//      --crf 20 -o docs/pokemon-progress-short.mp4
//
//  Vertical 1080×1920 for YouTube Shorts. Nine chapters:
//    1  ARRIVAL ............. the full-colour Kanto atlas, whole -> Pallet
//                              Town -> Red's own front door, starters and
//                              the game character reprised, a swarm bursts
//                              out of the house — THEN the ambition, stated
//    2  nothing .............. it starts with zero
//    3  bedroom → house ...... first two milestones
//    4  Oak / starter / rival  the lab
//    5  Route 1 / mart / dex   the errand
//    6  reads the shop screen  a hardcoded script, replaced — 0/20 → 20/20
//    7  Viridian Forest ...... the current frontier
//    8  TODAY ................ a real swarm grid + today's finish-rate jump
//    9  the goal .............. a short closing card, stated as a goal
//
//  v1 (11faace) opened on the ambition and closed on a slow zoom into the
//  full-colour Kanto atlas. The captain watched it, liked it, and asked for
//  one change: "the ending shot and upbeat tune I want as the start
//  instead ... zoom in on pallet town, use the game character and starters
//  again, trigger a swarm out of the house." Read literally that is five
//  things — the map-zoom SHOT moves to the front (not the closing text: the
//  goal statement itself stays, honesty-critical, as a short card at the
//  end); the atlas earns more screen time, with a real destination (Pallet
//  Town, then Red's own door, both located from `pixelgb atlas`'s own
//  manifest, not eyeballed — see the .assets.md); the three starters and
//  the player's own overworld sprite reappear; and a burst of that same
//  character sprite pours out of the house — the money shot. What v1's
//  crew already got right (chapters 2-8, the honesty framing, the
//  documentary grade) is untouched.
//
//  Grade is "documentary" (muted) over the journey chapters (3–7) and
//  natural colour on the new opener, TODAY, and the closing card — grounded
//  journey, vivid arrival and payoff. Music is the built-in generated
//  chiptune (`src/music.rs`), mood "title", now arranged to open FULL
//  (upbeat, at the front, per the captain's note) rather than build to it,
//  settle for the journey chapters, and climax again on TODAY.
// =====================================================================
{
  "width": 1080,
  "height": 1920,
  "fps": 30.0,
  "title": "AI completes Pokémon — progress reel",
  "background": "#05070d",

  "audio": [
    {
      "music": {
        "mood": "title",
        "bpm": 120,
        "fit": "film",
        "arrangement": [
          { "name": "arrival",  "bars": 3, "intensity": "full" },
          { "name": "hook",     "bars": 2, "intensity": "tone" },
          { "name": "rise",     "bars": 4, "intensity": "kick" },
          { "name": "motion",   "bars": 2, "intensity": "pulse" },
          { "name": "tension",  "bars": 2, "intensity": "build" },
          { "name": "hush",     "bars": 1, "intensity": "tone" },
          { "name": "today",    "bars": 4, "intensity": "full" },
          { "name": "close",    "bars": 2, "intensity": "tone" }
        ]
      },
      "fade_in": 0.2,
      "fade_out": 1.6,
      "gain": 0.9
    }
  ],

  // ===============================================================
  //  1 — ARRIVAL. The full-colour Kanto atlas (`kanto-atlas-full.png`,
  //  the "region-tint" render straight off the cartridge — see the
  //  .assets.md for the exact regen command and the pixel-exact door
  //  coordinates below). Whole map -> Pallet Town -> Red's own front
  //  door, located from `pixelgb atlas`'s own manifest (map id 0's
  //  `rect`, and warp index 0's tile), not eyeballed. The camera holds
  //  on the door from 3.0s, so the swarm below bursts from a door that
  //  has actually stopped moving under it — a still-moving camera would
  //  desync the burst's frame-centred launch point from the door itself.
  // ===============================================================
  "opening": {
    "name": "arrival",
    "duration": 6.6,
    "background": "#05070d",
    "layers": [
      {
        "type": "still",
        "asset": "kanto-atlas-full.png",
        "fit": "cover",
        "camera": {
          "shots": [
            { "at": 0.0, "framing": { "on": "whole" }, "ease": "in-out-cubic" },
            { "at": 1.6, "framing": { "on": "at", "fx": 0.20256, "fy": 0.61873, "height": 450.0 }, "ease": "in-out-cubic" },
            { "at": 3.0, "framing": { "on": "at", "fx": 0.19296, "fy": 0.61111, "height": 200.0 }, "ease": "in-out-cubic" }
          ]
        }
      },

      // -- the cast, reprised: the game character and the three starters,
      //    a quick row across the top while the map is still descending --
      { "type": "still", "asset": "sprites/four-shade/8x/overworld-red-down-walk.png", "fit": "contain",
        "placement": { "fx": 0.05, "fy": 0.07, "fw": 0.19, "fh": 0.16 }, "from": 2.55, "duration": 1.0, "z": 3,
        "enter": { "kind": "rise", "distance": 20.0, "duration": 0.3 }, "exit": { "kind": "fade", "duration": 0.25 } },
      { "type": "still", "asset": "sprites/four-shade/8x/pokemon-front-001-bulbasaur.png", "fit": "contain",
        "placement": { "fx": 0.265, "fy": 0.07, "fw": 0.19, "fh": 0.16 }, "from": 2.65, "duration": 1.0, "z": 3,
        "enter": { "kind": "rise", "distance": 20.0, "duration": 0.3 }, "exit": { "kind": "fade", "duration": 0.25 } },
      { "type": "still", "asset": "sprites/four-shade/8x/pokemon-front-004-charmander.png", "fit": "contain",
        "placement": { "fx": 0.48, "fy": 0.07, "fw": 0.19, "fh": 0.16 }, "from": 2.75, "duration": 1.0, "z": 3,
        "enter": { "kind": "rise", "distance": 20.0, "duration": 0.3 }, "exit": { "kind": "fade", "duration": 0.25 } },
      { "type": "still", "asset": "sprites/four-shade/8x/pokemon-front-007-squirtle.png", "fit": "contain",
        "placement": { "fx": 0.695, "fy": 0.07, "fw": 0.19, "fh": 0.16 }, "from": 2.85, "duration": 1.0, "z": 3,
        "enter": { "kind": "rise", "distance": 20.0, "duration": 0.3 }, "exit": { "kind": "fade", "duration": 0.25 } },

      // -- the swarm, bursting out of the house. Seven copies of the same
      //    game-character sprite, launched from the door (frame-centred
      //    once the camera holds — see above) on headings fanned across
      //    the town square in front of the house (20°-160° clockwise from
      //    +x/right, i.e. mostly downward and outward, never back into the
      //    building) — the drift/Placement::Frac idiom `Layer::burst`
      //    itself is built from (AGENTS.md), written by hand here for a
      //    still rather than a clip. `in-quad` easing (accelerating
      //    outward reads as energy, per the burst-demo finding). --
      { "type": "still", "asset": "sprites/four-shade/8x/overworld-red-down-walk.png", "fit": "contain",
        "placement": { "fx": 0.45, "fy": 0.45, "fw": 0.10, "fh": 0.10 }, "from": 3.00, "duration": 0.85, "z": 5,
        "drift": { "dx": 456.5, "dy": 148.3, "scale_to": 1.6, "easing": "in-quad" },
        "enter": { "kind": "scale", "from": 0.3, "duration": 0.15, "timing": { "kind": "eased", "easing": "out-back" } },
        "exit": { "kind": "fade", "duration": 0.2 } },
      { "type": "still", "asset": "sprites/four-shade/8x/overworld-red-side-walk.png", "fit": "contain",
        "placement": { "fx": 0.45, "fy": 0.45, "fw": 0.10, "fh": 0.10 }, "from": 3.10, "duration": 0.85, "z": 6,
        "drift": { "dx": 327.4, "dy": 351.0, "scale_to": 1.6, "easing": "in-quad" },
        "enter": { "kind": "scale", "from": 0.3, "duration": 0.15, "timing": { "kind": "eased", "easing": "out-back" } },
        "exit": { "kind": "fade", "duration": 0.2 } },
      { "type": "still", "asset": "sprites/four-shade/8x/overworld-red-up-walk.png", "fit": "contain",
        "placement": { "fx": 0.45, "fy": 0.45, "fw": 0.10, "fh": 0.10 }, "from": 3.20, "duration": 0.85, "z": 7,
        "drift": { "dx": 225.3, "dy": 423.8, "scale_to": 1.6, "easing": "in-quad" },
        "enter": { "kind": "scale", "from": 0.3, "duration": 0.15, "timing": { "kind": "eased", "easing": "out-back" } },
        "exit": { "kind": "fade", "duration": 0.2 } },
      { "type": "still", "asset": "sprites/four-shade/8x/overworld-red-down-walk.png", "fit": "contain",
        "placement": { "fx": 0.45, "fy": 0.45, "fw": 0.10, "fh": 0.10 }, "from": 3.30, "duration": 0.85, "z": 8,
        "drift": { "dx": -16.8, "dy": 479.7, "scale_to": 1.6, "easing": "in-quad" },
        "enter": { "kind": "scale", "from": 0.3, "duration": 0.15, "timing": { "kind": "eased", "easing": "out-back" } },
        "exit": { "kind": "fade", "duration": 0.2 } },
      { "type": "still", "asset": "sprites/four-shade/8x/overworld-red-side-walk.png", "fit": "contain",
        "placement": { "fx": 0.45, "fy": 0.45, "fw": 0.10, "fh": 0.10 }, "from": 3.40, "duration": 0.85, "z": 9,
        "drift": { "dx": -172.0, "dy": 448.1, "scale_to": 1.6, "easing": "in-quad" },
        "enter": { "kind": "scale", "from": 0.3, "duration": 0.15, "timing": { "kind": "eased", "easing": "out-back" } },
        "exit": { "kind": "fade", "duration": 0.2 } },
      { "type": "still", "asset": "sprites/four-shade/8x/overworld-red-up-walk.png", "fit": "contain",
        "placement": { "fx": 0.45, "fy": 0.45, "fw": 0.10, "fh": 0.10 }, "from": 3.50, "duration": 0.85, "z": 10,
        "drift": { "dx": -362.3, "dy": 314.9, "scale_to": 1.6, "easing": "in-quad" },
        "enter": { "kind": "scale", "from": 0.3, "duration": 0.15, "timing": { "kind": "eased", "easing": "out-back" } },
        "exit": { "kind": "fade", "duration": 0.2 } },
      { "type": "still", "asset": "sprites/four-shade/8x/overworld-red-down-walk.png", "fit": "contain",
        "placement": { "fx": 0.45, "fy": 0.45, "fw": 0.10, "fh": 0.10 }, "from": 3.60, "duration": 0.85, "z": 11,
        "drift": { "dx": -459.0, "dy": 140.3, "scale_to": 1.6, "easing": "in-quad" },
        "enter": { "kind": "scale", "from": 0.3, "duration": 0.15, "timing": { "kind": "eased", "easing": "out-back" } },
        "exit": { "kind": "fade", "duration": 0.2 } },

      // -- the ambition, stated once the swarm has actually cleared the
      //    frame (burst's last sprite fades by ~4.45s) — not stacked under
      //    it: a solid backing bar this size sitting on top of the burst
      //    from the start smothered "the single most watchable idea" the
      //    first time this was rendered and checked. The default title
      //    style (104px; AGENTS.md's own sharp edge: a Title's placement
      //    box does not clip or clamp wrapped text) also wrapped "AI
      //    COMPLETES POKÉMON" onto three lines and ran the subtitle off
      //    the bottom of the frame — an explicit, smaller size here, same
      //    as every other chapter's Title in this film already sets. --
      { "type": "solid", "colour": "#05070de6", "placement": { "fx": 0.03, "fy": 0.35, "fw": 0.94, "fh": 0.40 }, "from": 4.4, "duration": 2.2, "z": 15,
        "enter": { "kind": "fade", "duration": 0.3 } },
      {
        "type": "still",
        "asset": "title/four-shade/8x/pokemon-logo.png",
        "fit": "contain",
        "placement": { "fx": 0.20, "fy": 0.37, "fw": 0.60, "fh": 0.09 },
        "from": 4.6, "duration": 2.0, "z": 20,
        "enter": { "kind": "fade", "duration": 0.5, "timing": { "kind": "eased", "easing": "out-cubic" } }
      },
      {
        "type": "title",
        "text": "AI COMPLETES POKÉMON",
        "subtitle": "the journey so far — not there yet",
        "placement": { "fx": 0.06, "fy": 0.49, "fw": 0.88, "fh": 0.24 },
        "from": 4.6, "duration": 2.0, "z": 20,
        "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 800, "italic": false, "size": 58.0, "tracking": -0.015, "line_height": 1.08, "fill": "#ffffff", "case": "as-written", "align": "centre", "tabular": false },
        "subtitle_style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 500, "italic": false, "size": 30.0, "tracking": 0.005, "line_height": 1.3, "fill": "#c4cbd6", "case": "as-written", "align": "centre", "tabular": false },
        "enter": {
          "kind": "chars", "stagger": 0.035, "rise": 26.0, "duration": 0.5,
          "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } }
        }
      }
    ]
  },

  "then": [

    // =============================================================
    //  2 — NOTHING. Abrupt cut in — the blunt truth deserves no
    //  dissolve.
    // =============================================================
    {
      "transition": { "duration": 0.05, "presentation": { "kind": "cut" }, "timing": { "kind": "eased", "easing": "linear" } },
      "scene": {
        "name": "nothing",
        "duration": 2.0,
        "background": "#020204",
        "layers": [
          {
            "type": "title",
            "text": "IT STARTS KNOWING NOTHING.",
            "subtitle": "just the screen it sees — no memory of the game",
            "placement": { "fx": 0.08, "fy": 0.20, "fw": 0.84, "fh": 0.60 },
            "enter": { "kind": "fade", "duration": 0.4, "timing": { "kind": "eased", "easing": "out-cubic" } }
          }
        ]
      }
    },

    // =============================================================
    //  3 — BEDROOM → HOUSE. Two real captured frames from a finished
    //  run (agent a01, seed 4200127), timed back to back.
    // =============================================================
    {
      "transition": { "duration": 0.4, "presentation": { "kind": "fade", "through": "#000000" }, "timing": { "kind": "eased", "easing": "in-out-cubic" } },
      "scene": {
        "name": "bedroom-house",
        "duration": 4.0,
        "background": "#0a0e18",
        "grade": "documentary",
        "layers": [
          {
            "type": "still",
            "asset": "maps/four-shade/8x/038-reds-house-2f.png",
            "fit": "cover",
            "camera": {
              "shots": [
                { "at": 0.0, "framing": { "on": "whole" }, "ease": "in-out-cubic" },
                { "at": 4.0, "framing": { "on": "at", "fx": 0.5, "fy": 0.55, "height": 700.0 }, "ease": "in-out-cubic" }
              ]
            }
          },
          { "type": "scrim", "height": 0.5, "strength": 0.85, "colour": "#000000" },

          { "type": "solid", "colour": "#05070dd0", "placement": { "fx": 0.06, "fy": 0.18, "fw": 0.88, "fh": 0.34 }, "from": 0.0, "duration": 2.0, "z": 2 },
          { "type": "still", "asset": "frames/bedroom.png", "fit": "contain", "placement": { "fx": 0.09, "fy": 0.20, "fw": 0.82, "fh": 0.30 }, "from": 0.0, "duration": 2.0, "z": 3,
            "enter": { "kind": "fade", "duration": 0.3 }, "exit": { "kind": "fade", "duration": 0.3 } },
          { "type": "title", "text": "LEAVES THE BEDROOM.", "placement": { "fx": 0.06, "fy": 0.58, "fw": 0.88, "fh": 0.30 }, "from": 0.1, "duration": 1.8, "z": 4,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 800, "italic": false, "size": 72.0, "tracking": -0.015, "line_height": 1.08, "fill": "#ffffff", "case": "as-written", "align": "centre", "tabular": false },
            "enter": { "kind": "chars", "stagger": 0.03, "rise": 20.0, "duration": 0.4, "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } } } },

          { "type": "solid", "colour": "#05070dd0", "placement": { "fx": 0.06, "fy": 0.18, "fw": 0.88, "fh": 0.34 }, "from": 2.0, "duration": 2.0, "z": 2 },
          { "type": "still", "asset": "frames/leave-house.png", "fit": "contain", "placement": { "fx": 0.09, "fy": 0.20, "fw": 0.82, "fh": 0.30 }, "from": 2.0, "duration": 2.0, "z": 3,
            "enter": { "kind": "fade", "duration": 0.3 }, "exit": { "kind": "fade", "duration": 0.3 } },
          { "type": "title", "text": "THEN THE HOUSE.", "placement": { "fx": 0.06, "fy": 0.58, "fw": 0.88, "fh": 0.30 }, "from": 2.1, "duration": 1.8, "z": 4,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 800, "italic": false, "size": 72.0, "tracking": -0.015, "line_height": 1.08, "fill": "#ffffff", "case": "as-written", "align": "centre", "tabular": false },
            "enter": { "kind": "chars", "stagger": 0.03, "rise": 20.0, "duration": 0.4, "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } } } }
        ]
      }
    },

    // =============================================================
    //  4 — OAK / STARTER / RIVAL. Portraits from the cartridge; the
    //  starter is shown as a choice (all three), not a specific pick —
    //  the run's own choice was never confirmed independently.
    // =============================================================
    {
      "transition": { "duration": 0.3, "presentation": { "kind": "dissolve" }, "timing": { "kind": "eased", "easing": "in-out-cubic" } },
      "scene": {
        "name": "oak-starter-rival",
        "duration": 4.5,
        "background": "#0a0e18",
        "grade": "documentary",
        "layers": [
          { "type": "still", "asset": "maps/four-shade/8x/000-pallet-town.png", "fit": "cover" },
          { "type": "scrim", "height": 0.5, "strength": 0.85, "colour": "#000000" },

          { "type": "still", "asset": "frames/oak-portrait.png", "fit": "contain", "placement": { "fx": 0.28, "fy": 0.18, "fw": 0.44, "fh": 0.28 }, "from": 0.0, "duration": 1.5, "z": 3,
            "enter": { "kind": "scale", "from": 0.85, "duration": 0.35 }, "exit": { "kind": "fade", "duration": 0.25 } },
          { "type": "title", "text": "OAK.", "placement": { "fx": 0.06, "fy": 0.58, "fw": 0.88, "fh": 0.30 }, "from": 0.05, "duration": 1.4, "z": 4,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 800, "italic": false, "size": 72.0, "tracking": -0.015, "line_height": 1.08, "fill": "#ffffff", "case": "as-written", "align": "centre", "tabular": false },
            "enter": { "kind": "chars", "stagger": 0.03, "rise": 20.0, "duration": 0.4, "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } } } },

          { "type": "still", "asset": "sprites/four-shade/8x/pokemon-front-001-bulbasaur.png", "fit": "contain", "placement": { "fx": 0.06, "fy": 0.20, "fw": 0.28, "fh": 0.18 }, "from": 1.5, "duration": 1.6, "z": 3,
            "enter": { "kind": "rise", "distance": 24.0, "duration": 0.3 } },
          { "type": "still", "asset": "sprites/four-shade/8x/pokemon-front-004-charmander.png", "fit": "contain", "placement": { "fx": 0.36, "fy": 0.20, "fw": 0.28, "fh": 0.18 }, "from": 1.6, "duration": 1.5, "z": 3,
            "enter": { "kind": "rise", "distance": 24.0, "duration": 0.3 } },
          { "type": "still", "asset": "sprites/four-shade/8x/pokemon-front-007-squirtle.png", "fit": "contain", "placement": { "fx": 0.66, "fy": 0.20, "fw": 0.28, "fh": 0.18 }, "from": 1.7, "duration": 1.4, "z": 3,
            "enter": { "kind": "rise", "distance": 24.0, "duration": 0.3 } },
          { "type": "title", "text": "THE STARTER.", "placement": { "fx": 0.06, "fy": 0.58, "fw": 0.88, "fh": 0.30 }, "from": 1.6, "duration": 1.4, "z": 4,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 800, "italic": false, "size": 72.0, "tracking": -0.015, "line_height": 1.08, "fill": "#ffffff", "case": "as-written", "align": "centre", "tabular": false },
            "enter": { "kind": "chars", "stagger": 0.03, "rise": 20.0, "duration": 0.4, "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } } } },

          { "type": "still", "asset": "frames/rival-portrait.png", "fit": "contain", "placement": { "fx": 0.28, "fy": 0.18, "fw": 0.44, "fh": 0.28 }, "from": 3.1, "duration": 1.4, "z": 3,
            "enter": { "kind": "scale", "from": 0.85, "duration": 0.35 } },
          { "type": "title", "text": "THE FIRST RIVAL BATTLE.", "placement": { "fx": 0.06, "fy": 0.58, "fw": 0.88, "fh": 0.30 }, "from": 3.15, "duration": 1.35, "z": 4,
            "style": { "family": ["Montserrat","Open Sans","DejaVu Sans"], "weight": 800, "italic": false, "size": 66.0, "tracking": -0.015, "line_height": 1.08, "fill": "#ffffff", "case": "as-written", "align": "centre", "tabular": false },
            "enter": { "kind": "chars", "stagger": 0.03, "rise": 20.0, "duration": 0.4, "timing": { "kind": "spring", "spring": { "mass": 1.0, "stiffness": 120.0, "damping": 20.0, "clamp": false } } } }
        ]
      }
    },

    // =============================================================
    //  5 — ROUTE 1 / MART / PARCEL / POKÉDEX.
    // =============================================================
    {
      "transition": { "duration": 0.3, "presentation": { "kind": "dissolve" }, "timing": { "kind": "eased", "easing": "in-out-cubic" } },
      "scene": {
        "name": "route1-mart-dex",
        "duration": 4.0,
        "background": "#0a0e18",
        "grade": "documentary",
        "layers": [
