        "type": "chart",
        "chart": {
          "series": [
            {
              "kind": "function",
              "expr": "40*log(x+1)",
              "samples": 240,
              "width": 5.0,
              "fill": false,
              "dots": false
            }
          ],
          "x": {
            "min": 0.0,
            "max": 80.0,
            "label": "age (years)"
          },
          "y": {
            "label": "how fast a year feels"
          },
          "reveal": {
            "over": 2.0,
            "easing": "out-cubic"
          },
          "markers": [
            {
              "type": "v-line",
              "x": 40.0,
              "colour": "#ffd147",
              "label": "midpoint",
              "width": 3.0
            }
