        "enter": {
          "kind": "rise",
          "distance": 40.0,
          "duration": 0.7,
          "timing": {
            "kind": "spring",
            "spring": {
              "mass": 1.0,
              "stiffness": 120.0,
              "damping": 20.0,
              "clamp": false
            }
          }
        },
        "exit": null,
        "opacity": 1.0,
        "z": 0
      },
