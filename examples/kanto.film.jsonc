  // The cartridge's own title theme, recorded off our emulator's sound chip
  // (see examples/README.md for how) — laid down as two reads of the same
  // file at the same source offset, which is how a constant-gain mixer
  // expresses a level change: the first carries the title screen and
  // recedes, the second comes up underneath at a fifth of the volume and
  // stays there. Reading both from the same source second keeps them
  // phase-aligned, so the performance itself never cuts — only its volume
  // moves.
  "audio": [
    {
      "asset": "pokemon-blue-title.wav",
      "duration": 8.2,
      "fade_in": 0.35,
      "fade_out": 3.2,
    },
    {
      "asset": "pokemon-blue-title.wav",
      "at": 5.0,
      "from": 5.0,
      "fade_in": 3.2,
      "fade_out": 3.5,
      "gain": 0.2
    },
  ],
  "opening": {
    // The cartridge's own title screen, not a picture of one: a real
    // capture, nearest-neighbour magnified so the Game Boy's pixels stay
    // square. Held a beat before the title card animates in over it.
