      "scene": {
        "name": "the pull-back",
        "duration": 11.0,
        "background": "#07090e",
        "layers": [
          {
            "type": "still",
            "asset": "kanto.png",
            "fit": "cover",
            // The move this whole toolset exists for: open at 1:1 on the
            // Game Boy's own 160×144 window over Pallet Town, hold a beat,
            // then pull back until all 226 maps are in frame — one
            // continuous move across a 48-megapixel picture. Both ends are
            // framed on the *same point*, so only the height changes: the
            // camera stays on its subject for as long as it can stay
            // centred, and only slides once the widening view no longer
            // fits within the source (clamp_to_source below). Framing the
            // far end as "whole" instead would start the centre travelling
            // immediately, drifting off Pallet Town onto empty ground while
            // still too zoomed in to show why that matters.
            "camera": {
              "shots": [
                {
                  "at": 0.0,
                  "framing": {
                    "on": "point",
                    "x": 1520.0,
                    "y": 4560.0,
                    "height": 144.0
                  },
                  "ease": "in-out-cubic"
                },
                {
                  "at": 1.1,
